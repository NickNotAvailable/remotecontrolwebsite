{
  "name": "channel-surf-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A director's portfolio that behaves like a television, with a phone browser as the remote control.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "uqr": "^0.1.3",
    "vite": "^8.3.3"
  }
}
